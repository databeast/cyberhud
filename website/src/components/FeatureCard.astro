---
/*
 * FeatureCard.astro — Individual feature card with media, title, and description.
 *
 * Displays a feature image/gif with lazy loading, an onerror fallback to a
 * cyberpunk-themed placeholder SVG, and descriptive text content.
 *
 */

interface Props {
    title: string;
    description: string;
    mediaSrc: string;
    mediaAlt: string;
    mediaWidth: number;
    mediaHeight: number;
    index: number;
}

const {title, description, mediaSrc, mediaAlt, mediaWidth, mediaHeight, index} = Astro.props;
const fallbackSrc = '/images/placeholder.svg';
---

<article class="feature-card" style={`--card-index: ${index};`}>
    <div class="feature-card__media">
        <img
                src={mediaSrc}
                alt={mediaAlt}
                width={mediaWidth}
                height={mediaHeight}
                loading="lazy"
                class="feature-card__image"
                onerror={`this.onerror=null;this.src='${fallbackSrc}';`}
        />
    </div>
    <div class="feature-card__body">
        <h3 class="feature-card__title">{title}</h3>
        <p class="feature-card__description">{description}</p>
    </div>
</article>

<style>
    .feature-card {
        display: flex;
        flex-direction: column;
        background-color: var(--color-bg-surface);
        border: 1px solid color-mix(in srgb, var(--color-accent-cyan) 20%, transparent);
        border-radius: var(--radius-lg);
        overflow: hidden;
        transition: border-color var(--duration-normal) var(--ease-out),
        box-shadow var(--duration-normal) var(--ease-out);
        opacity: 0;
        transform: translateY(20px);
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .feature-card.visible {
        animation: fadeInUp var(--duration-slow) var(--ease-out) forwards;
        animation-delay: calc(var(--card-index, 0) * 150ms);
    }

    @media (prefers-reduced-motion: reduce) {
        .feature-card {
            opacity: 1;
            transform: translateY(0);
        }

        .feature-card.visible {
            animation: none;
        }
    }

    .feature-card:hover {
        border-color: color-mix(in srgb, var(--color-accent-cyan) 50%, transparent);
        box-shadow: 0 0 16px color-mix(in srgb, var(--color-accent-cyan) 15%, transparent);
    }

    .feature-card__media {
        position: relative;
        min-height: 150px;
        background-color: var(--color-bg-elevated);
    }

    .feature-card__image {
        display: block;
        width: 100%;
        height: auto;
        min-width: 200px;
        min-height: 150px;
        object-fit: cover;
    }

    .feature-card__body {
        padding: var(--space-6);
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }

    .feature-card__title {
        font-family: var(--font-mono);
        font-size: var(--text-lg);
        color: var(--color-accent-cyan);
        margin: 0;
        line-height: var(--leading-tight);
    }

    .feature-card__description {
        font-family: var(--font-body);
        font-size: var(--text-base);
        color: var(--color-text-secondary);
        margin: 0;
        line-height: var(--leading-normal);
    }
</style>
