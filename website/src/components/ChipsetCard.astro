---
/*
 * ChipsetCard.astro — Displays a supported chipset family.
 * Shows the family name, the controller chips it covers, and a one-line
 * note on what the family is good for.
 */
interface Props {
    family: string;
    controllers: string[];
    note: string;
}

const {family, controllers, note} = Astro.props;
---

<article class="chipset-card">
    <h3 class="chipset-card__name">{family}</h3>
    <p class="chipset-card__note">{note}</p>
    <dl class="chipset-card__specs">
        <div class="chipset-card__spec">
            <dt>Controllers</dt>
            <dd>{controllers.join(', ')}</dd>
        </div>
    </dl>
</article>

<style>
    .chipset-card {
        background: var(--color-bg-surface);
        border: 1px solid var(--color-accent-cyan);
        border-radius: var(--radius-md);
        padding: var(--space-6);
        transition: border-color var(--duration-normal) var(--ease-out),
        box-shadow var(--duration-normal) var(--ease-out);
    }

    .chipset-card:hover {
        border-color: var(--color-accent-magenta);
        box-shadow: 0 0 12px hsla(300, 100%, 55%, 0.2);
    }

    .chipset-card__name {
        font-family: var(--font-body);
        font-size: var(--text-lg);
        color: var(--color-text-primary);
        margin: 0 0 var(--space-3);
        line-height: var(--leading-tight);
    }

    .chipset-card__note {
        font-family: var(--font-body);
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
        margin: 0 0 var(--space-4);
        line-height: var(--leading-normal);
    }

    .chipset-card__specs {
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }

    .chipset-card__spec {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
    }

    .chipset-card__spec dt {
        font-family: var(--font-body);
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .chipset-card__spec dd {
        font-family: var(--font-mono);
        font-size: var(--text-base);
        color: var(--color-accent-cyan);
        margin: 0;
    }
</style>
