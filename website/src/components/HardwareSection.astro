---
/*
 * HardwareSection.astro — Supported hardware section.
 * Groups supported panels by controller chipset rather than listing every
 * individual product, since visitors already know the specs of the panel
 * they own — what they need to know is whether their chip is supported.
 */
import {supportedControllerFamilies} from '../data/hardware';
import ChipsetCard from './ChipsetCard.astro';
---

<section id="hardware" class="hardware-section" aria-label="Supported hardware">
    <div class="hardware-section__container">
        <h2 class="hardware-section__heading">Supported Hardware</h2>

        <p class="hardware-section__compat">
            CyberHUD supports 20 display-controller drivers across color LCD and OLED, e-paper, memory LCD, and LED
            matrices.
            Common boards work out of the box; compatible panels can use a generic configuration with the right
            transport, dimensions, and GPIO pins—no code required.
        </p>

        <div class="hardware-section__grid">
            {supportedControllerFamilies.map((group) => (
                    <ChipsetCard family={group.family} controllers={group.controllers} note={group.note}/>
            ))}
        </div>

        <p class="hardware-section__footnote">
            Native panel profiles include common Waveshare and Adafruit boards. Other panels need matching interfaces
            and may require panel-specific pin or configuration overrides.
        </p>
    </div>
</section>

<style>
    .hardware-section {
        padding: var(--space-16) var(--space-4);
        background: var(--color-bg-base);
        overflow-x: hidden;
    }

    .hardware-section__container {
        max-width: 72rem;
        margin: 0 auto;
    }

    .hardware-section__heading {
        font-family: var(--font-body);
        font-size: var(--text-3xl);
        color: var(--color-text-primary);
        text-align: center;
        margin: 0 0 var(--space-4);
        line-height: var(--leading-tight);
    }

    .hardware-section__compat {
        font-family: var(--font-mono);
        font-size: var(--text-base);
        color: var(--color-accent-green);
        text-align: center;
        margin: 0 0 var(--space-12);
    }

    .hardware-section__grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
        gap: var(--space-6);
    }

    .hardware-section__footnote {
        font-family: var(--font-body);
        font-size: var(--text-sm);
        color: var(--color-text-secondary);
        text-align: center;
        margin: var(--space-8) 0 0;
    }

    @media (max-width: 768px) {
        .hardware-section__grid {
            grid-template-columns: 1fr;
        }

        .hardware-section__heading {
            font-size: var(--text-2xl);
        }
    }
</style>
