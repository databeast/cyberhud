{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.7,
            "aggregationMethod": "median-run"
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 4000,
            "aggregationMethod": "median-run"
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 2097152,
            "aggregationMethod": "median-run"
          }
        ]
      }
    }
  }
}
