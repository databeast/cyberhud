{
  "socket": "/run/cyberhudd/console.sock",
  "i2c": "/dev/i2c-1",
  "scan": "2s",
  "display": {
    "panel": "st7789-320x240",
    "disable_input": true,
    "dc": "GPIO25",
    "rst": "GPIO27",
    "bl": "GPIO18"
  },
  "policies": {
    "attract_matrix": {
      "min_speed": 1.5,
      "max_speed": 8.0,
      "trail_length": 24,
      "density": 1.0,
      "show_background": true
    },
    "attract_bokeh": {
      "speed": 0.8,
      "density": 0.7,
      "size_variance": 0.6,
      "saturation": 0.9
    },
    "dashboard": {
      "style": "color-320x240",
      "color_accent": "amber"
    }
  }
}
